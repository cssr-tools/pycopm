"""Script to write the rock permeability values"""

import json


def perm_evaluation():
    """Permeability assignation"""
    % if rock_property_settings[i][1] > 0 and execution_mode in ["files","ert"]:
    with open("${rock_property_settings[i][0]}.json") as f:
        C = json.load(f)
    % endif

    """Permeability assignation"""
    P = [0. for i in range(${len(active)})]
    % for k in range(len(active)):
    % if rock_property_settings[i][1] > 0 and execution_mode in ["files","ert"]:
    % if active[k] == 1:
    P[${k}] = max(1e1,min(C["${rock_property_settings[i][0]}${np.sum(active[0:k])}"],1e9))
    % endif
    % else:
    P[${k}] = ${values_c[k]}
    % endif
    % endfor

    with open("${rock_property_settings[i][0].lower()}.inc", "w") as f:
        f.write("-- This file was generated by pycopm https://github.com/cssr-tools/pycopm\n")
        f.write("${rock_property_settings[i][0]}\n")
        f.write(" ".join(list(map(str,P))))
        f.write(" /")

if __name__ == "__main__":
    perm_evaluation()
